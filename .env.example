# =============================================================================
# VOTE WITH BLOCK — Environment Configuration
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.
# =============================================================================

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# --- Frontend ---
NEXT_PUBLIC_CORE_GATEWAY_URL=http://localhost:8080

# --- CORS ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Voter Authentication (Pre-Auth & Session tokens) ---
# Use separate random secrets for each purpose. Generate with: ./generate-secret.ps1
APP_AUTH_SESSION_SECRET=CHANGE_ME_32plus_char_random_session_secret
APP_AUTH_PREAUTH_SECRET=CHANGE_ME_32plus_char_random_preauth_secret

# --- Voter Bootstrap (DISABLE in production) ---
APP_AUTH_ALLOW_BOOTSTRAP_PASSWORD=false
APP_AUTH_BOOTSTRAP_PASSWORD=

# --- Demo Mode (DISABLE in production) ---
APP_DEMO_SEED_VOTER=
APP_DEMO_PASSWORD=

# --- JPA ---
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# --- Admin Authentication ---
# Must be a DIFFERENT secret from voter session secret
APP_ADMIN_TOKEN_SECRET=CHANGE_ME_32plus_char_random_admin_secret
APP_ADMIN_BOOTSTRAP_ENABLED=true
APP_ADMIN_BOOTSTRAP_USERNAME=admin
APP_ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_strong_admin_password

# --- Biometric Encryption ---
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_BIOMETRIC_ENCRYPTION_KEY=
